{
  "name": "@thomasfosterau/monorepo",
  "private": true,
  "description": "Svelte component library and portable chart specification / interpreters, in one Vite+ workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @thomasfosterau/components",
    "test": "vp test",
    "check": "vp check && npm run check -w @thomasfosterau/components",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "build": "vp run -r build",
    "emit-schema": "npm run emit-schema -w @thomasfosterau/chart-spec",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@voidzero-dev/vite-plus-core": "0.3.2",
    "happy-dom": "^20.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "6.0.3",
    "vite-plus": "0.3.2",
    "vitest": "4.1.11",
    "vue": "^3.5.35"
  },
  "overrides": {
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "npm@11.16.0"
}
