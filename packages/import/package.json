{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/components-import",
  "version": "0.1.1",
  "description": "A data import mapper: map any table a user has onto an app's Effect Schema, with a serialisable, versioned mapping spec and a Svelte 5 UI",
  "keywords": [
    "csv",
    "effect",
    "effect-schema",
    "import",
    "mapping",
    "spreadsheet",
    "svelte",
    "svelte5"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/components.git",
    "directory": "packages/import"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@thomasfosterau/components": "workspace:*"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@storybook/addon-svelte-csf": "catalog:",
    "@storybook/sveltekit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@thomasfosterau/effect-document": "catalog:",
    "@thomasfosterau/effect-parse": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-document": "catalog:peers",
    "effect": "catalog:peers",
    "svelte": "catalog:peers"
  }
}
