{
  // Kit's generated config (written by `svelte-kit sync`) wins where both set an option.
  "extends": ["../../tsconfig.base.json", "$app/tsconfig"],
  "compilerOptions": {
    // Kit warns if `$app/types` is dropped; `vite/client` types asset imports.
    "types": ["$app/types", "node", "vite/client"]
  },
  "include": ["src", "tests"]
}
