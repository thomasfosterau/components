{
  // The headless core, its suite and the configs. The core's portability (no
  // DOM, no Node) is re-checked by tsconfig.pure.json. The `./svelte` entry,
  // its stories and its browser suite are `.svelte` or import it, which `tsc`
  // cannot read: tsconfig.svelte.json covers them.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The Effect Language Service, run by the Effect-patched native `tsc`
    // (the root `prepare`: `effect-tsgo patch --typescript`). The whole of
    // `src` is Effect code, so its diagnostics land everywhere here. Warnings
    // stay visible in the editor and in the `check` output but do not fail the
    // exit code.
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectWarningsInTscExitCode": true
      }
    ]
  },
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": ["src/svelte", "src/stories", "tests/svelte"]
}
