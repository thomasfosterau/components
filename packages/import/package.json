{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/components-import",
  "version": "0.0.0",
  "description": "A data import mapper: map any table a user has onto an app's Effect Schema, with a serialisable, versioned mapping spec",
  "keywords": [
    "csv",
    "effect",
    "effect-schema",
    "import",
    "mapping",
    "spreadsheet"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/components.git",
    "directory": "packages/import"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:peers"
  }
}
