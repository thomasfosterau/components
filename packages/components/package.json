{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/components",
  "version": "0.1.0",
  "description": "Accessible Svelte 5 UI primitives — Tailwind CSS 4 and daisyUI 5 for styling, bits-ui for interaction",
  "keywords": [
    "accessibility",
    "bits-ui",
    "components",
    "daisyui",
    "svelte",
    "svelte5",
    "tailwindcss",
    "ui-library"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git",
    "directory": "packages/components"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "bits-ui": "catalog:",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-svelte-csf": "catalog:",
    "@storybook/sveltekit": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "daisyui": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "vitest-browser-svelte": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.30.1"
  }
}
