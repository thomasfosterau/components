{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible Svelte 5 components — Tailwind CSS 4, daisyUI 5 and bits-ui, in a Vite+ workspace",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "vp run -r build && node scripts/publish.mjs"
  },
  "dependencies": {
    "@thomasfosterau/charts": "workspace:*",
    "@thomasfosterau/components": "workspace:*",
    "@thomasfosterau/components-mapbox": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.26.0"
}
