{
  "name": "@thomasfosterau/charts",
  "version": "0.0.0",
  "description": "A declarative Svelte charting library with multiple render targets (SVG, Canvas, WebGPU)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/lib",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-package -o dist",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "echo 'No tests yet'",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@sveltejs/kit": "^2.8.5",
    "@sveltejs/package": "^2.3.7",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/d3-array": "^3.2.1",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-time": "^3.0.3",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.8",
    "svelte": "^4.2.19",
    "svelte-check": "^4.0.8",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0"
  },
  "svelte": "./dist/index.js",
  "keywords": [
    "svelte",
    "charts",
    "dataviz",
    "visualization",
    "d3",
    "canvas",
    "webgpu",
    "svg",
    "ssr",
    "pancake"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/charts.git"
  },
  "license": "MIT"
}

