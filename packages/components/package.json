{
  "name": "@thomasfosterau/components",
  "version": "0.1.0",
  "description": "Accessible Svelte 5 components styled with Tailwind CSS and built on Melt UI",
  "keywords": [
    "accessibility",
    "components",
    "melt-ui",
    "svelte",
    "svelte5",
    "tailwind",
    "ui-library"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git",
    "directory": "packages/components"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/app.css"
  },
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vp dev",
    "build": "svelte-kit sync && svelte-package",
    "preview": "vp preview",
    "build:demo": "vp build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "melt": "^0.44.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "8.0.0-next.4",
    "@sveltejs/kit": "3.0.0-next.27",
    "@sveltejs/package": "3.0.0-next.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "svelte": "^5.30.1"
  }
}
