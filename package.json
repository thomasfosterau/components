{
  "name": "@thomasfosterau/monorepo",
  "private": true,
  "description": "Accessible Svelte components, in a Vite+ workspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @thomasfosterau/components",
    "test": "vp test",
    "check": "vp check && npm run check -w @thomasfosterau/components",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "build": "vp run -r build",
    "build:demo": "npm run build:demo -w @thomasfosterau/components",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@voidzero-dev/vite-plus-core": "0.3.2",
    "svelte": "^5.57.0",
    "typescript": "6.0.3",
    "vite-plus": "0.3.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.2"
  },
  "engines": {
    "node": ">=22.17"
  },
  "packageManager": "npm@11.16.0"
}
