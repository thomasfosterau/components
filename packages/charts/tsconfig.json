{
  // The whole package: every entry, the tests and the schema script. The
  // interpreters (`react`, `vue`, `prosemirror`) legitimately touch the DOM,
  // so this config keeps the base's `dom` libs; `tsconfig.pure.json` re-checks
  // `spec` and `core` without them.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    // The Effect Language Service, run by the Effect-patched native `tsc`
    // (the root `prepare`: `effect-tsgo patch --typescript`). Only `src/spec`
    // imports Effect, so its diagnostics land there. Warnings stay visible in
    // the editor and in the `check` output but do not fail the exit code.
    "plugins": [
      {
        "name": "@effect/language-service",
        "ignoreEffectWarningsInTscExitCode": true
      }
    ]
  },
  "include": ["src", "tests", "scripts", "vite.config.ts"]
}
