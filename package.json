{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Accessible Svelte 5 components — Tailwind CSS 4, daisyUI 5 and bits-ui, in a Vite+ workspace",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "node scripts/publish.mjs"
  },
  "dependencies": {
    "@thomasfosterau/charts": "workspace:*",
    "@thomasfosterau/components": "workspace:*",
    "@thomasfosterau/components-import": "workspace:*",
    "@thomasfosterau/components-mapbox": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/tsgo": "catalog:",
    "@enfect/oxlint": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "fallow": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "lts"
    }
  },
  "engines": {
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.21.0"
}
