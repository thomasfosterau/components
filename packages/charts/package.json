{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/charts",
  "version": "0.1.0",
  "description": "A portable, renderer-agnostic chart spec — its JSON Schema, a pure TypeScript geometry core, and Svelte, ProseMirror and Vega-Lite interpreters",
  "keywords": [
    "charts",
    "grammar-of-graphics",
    "json-schema",
    "prosemirror",
    "svelte",
    "svelte5",
    "vega-lite",
    "visualization"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/components.git",
    "directory": "packages/charts"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./prosemirror": {
      "types": "./dist/prosemirror.d.mts",
      "default": "./dist/prosemirror.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./vega": {
      "types": "./dist/vega.d.mts",
      "default": "./dist/vega.mjs"
    },
    "./schema.json": "./schema/chart-spec.v1.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "d3-scale": "catalog:",
    "d3-shape": "catalog:",
    "effect": "catalog:published"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/d3-scale": "catalog:",
    "@types/d3-shape": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-view": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vega": "catalog:",
    "vega-lite": "catalog:"
  },
  "peerDependencies": {
    "prosemirror-model": "catalog:peers",
    "prosemirror-view": "catalog:peers",
    "svelte": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "prosemirror-model": {
      "optional": true
    },
    "prosemirror-view": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
