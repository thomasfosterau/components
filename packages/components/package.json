{
  "$schema": "https://www.schemastore.org/package",
  "name": "@thomasfosterau/components",
  "version": "0.1.0",
  "private": false,
  "description": "Accessible Svelte 5 UI primitives — Tailwind CSS 4 and daisyUI 5 for styling, bits-ui for interaction, every string a prop",
  "keywords": [
    "accessibility",
    "bits-ui",
    "components",
    "daisyui",
    "svelte",
    "svelte5",
    "tailwindcss",
    "ui-library"
  ],
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/components.git",
    "directory": "packages/components"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./citations": {
      "types": "./dist/citations/index.d.ts",
      "svelte": "./dist/citations/index.js",
      "default": "./dist/citations/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "svelte": "./dist/canvas/index.js",
      "default": "./dist/canvas/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "svelte": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./tips": {
      "types": "./dist/tips/index.d.ts",
      "svelte": "./dist/tips/index.js",
      "default": "./dist/tips/index.js"
    },
    "./hotkeys": {
      "types": "./dist/hotkeys/index.d.ts",
      "svelte": "./dist/hotkeys/index.js",
      "default": "./dist/hotkeys/index.js"
    },
    "./seo": {
      "types": "./dist/seo/index.d.ts",
      "svelte": "./dist/seo/index.js",
      "default": "./dist/seo/index.js"
    },
    "./entity-form": {
      "types": "./dist/forms/entity-form.d.ts",
      "svelte": "./dist/forms/entity-form.js",
      "default": "./dist/forms/entity-form.js"
    },
    "./context-menu": {
      "types": "./dist/ui/context-menu.d.ts",
      "svelte": "./dist/ui/context-menu.js",
      "default": "./dist/ui/context-menu.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@lucide/svelte": "catalog:",
    "bits-ui": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-svelte-csf": "catalog:",
    "@storybook/sveltekit": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@thomasfosterau/effect-forms-svelte": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "daisyui": "catalog:",
    "effect": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "vitest-browser-svelte": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-forms-svelte": "catalog:",
    "svelte": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@thomasfosterau/effect-forms-svelte": {
      "optional": true
    }
  }
}
