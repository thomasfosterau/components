{
  "name": "components",
  // The tag matches the catalog's `vite-plus` pin.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.8.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  // Chromium isn't installed here: the browser suites' `browser:install` task
  // installs it, with its system libraries, the first time one runs.
  "postCreateCommand": "vp install --frozen-lockfile",
  "containerEnv": { "PLAYWRIGHT_INSTALL_DEPS": "1" },
  // Storybook's dev server (`vp run --filter ./packages/components storybook`).
  "forwardPorts": [6006],
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "bradlc.vscode-tailwindcss",
        "Anthropic.claude-code",
        "oxc.oxc-vscode"
      ]
    }
  },
  "workspaceFolder": "/workspaces/components"
}
